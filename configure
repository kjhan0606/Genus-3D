#!/usr/bin/env python3
"""Detect the MPI C compiler and FFTW 2.x, then write config.make."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

SEARCH_PREFIXES = ('/usr', '/usr/local', '/opt/fftw')
HEADER = 'include/srfftw_mpi.h'
LIBS = ['-lsrfftw_mpi', '-lsfftw_mpi', '-lsrfftw', '-lsfftw', '-lm']


def need(name):
    if not shutil.which(name):
        raise ValueError('Missing tool: ' + name + '. Load your compiler/MPI module first.')
    return name


def resolve_cc(compiler, explicit):
    if explicit:
        return need(explicit)
    if compiler == 'intel':
        return need('mpiicx')
    if compiler == 'gnu':
        return need('mpicc')
    for candidate in ('mpicc', 'mpiicx'):
        if shutil.which(candidate):
            return candidate
    raise ValueError('Missing tool: mpicc. Load your compiler/MPI module first.')


def resolve_fftw2(prefix):
    if prefix:
        root = Path(prefix).expanduser()
    else:
        root = next((Path(p) for p in SEARCH_PREFIXES if (Path(p) / HEADER).is_file()), None)
        if root is None:
            raise ValueError('FFTW 2.x MPI headers (srfftw_mpi.h) not found; pass --fftw2 PREFIX')
    if not (root / HEADER).is_file():
        raise ValueError('srfftw_mpi.h not found under ' + str(root))
    return root


def trial_compile(cc, fftw2):
    program = ('#include <mpi.h>\n#include <srfftw_mpi.h>\n'
               'int main(int argc, char **argv){ MPI_Init(&argc, &argv); '
               'rfftwnd_mpi_plan p = rfftw3d_mpi_create_plan(MPI_COMM_WORLD, 4, 4, 4,'
               ' FFTW_REAL_TO_COMPLEX, FFTW_ESTIMATE); '
               'rfftwnd_mpi_destroy_plan(p); MPI_Finalize(); return 0; }\n')
    with tempfile.TemporaryDirectory(prefix='genus-configure-') as temp:
        source = Path(temp) / 'probe.c'
        source.write_text(program)
        cmd = [cc, '-I' + str(fftw2 / 'include'), str(source),
               '-L' + str(fftw2 / 'lib'), *LIBS, '-o', str(Path(temp) / 'probe')]
        print('+ ' + ' '.join(cmd), flush=True)
        subprocess.run(cmd, check=True, capture_output=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--compiler', choices=('auto', 'gnu', 'intel'), default='auto')
    parser.add_argument('--fftw2', default='', help='FFTW 2.x install prefix')
    parser.add_argument('--cc', default='', help='Explicit MPI C compiler')
    args = parser.parse_args(argv)
    try:
        cc = resolve_cc(args.compiler, args.cc)
        fftw2 = resolve_fftw2(args.fftw2)
        trial_compile(cc, fftw2)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        raise SystemExit('configure failed: ' + str(error))
    root = Path(__file__).resolve().parent
    (root / 'config.make').write_text(
        '# Generated by configure; do not edit. Re-run configure to regenerate.\n'
        f'CC = {cc}\nFFTW2 = {fftw2}\n')
    print(f'Configured: CC={cc} FFTW2={fftw2}')
    print('Wrote ' + str(root / 'config.make'))


if __name__ == '__main__':
    main()
